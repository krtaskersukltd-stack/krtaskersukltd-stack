# Generate a bcrypt hash; never commit the plaintext admin password.
ADMIN_PASSWORD_HASH=

# Use at least 32 random characters for each secret.
SESSION_SECRET=
RATE_LIMIT_SALT=

# Added automatically when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Server-only contact form key. Do not use a NEXT_PUBLIC_ prefix.
WEB3FORMS_ACCESS_KEY=
